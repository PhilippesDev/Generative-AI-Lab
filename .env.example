# Environnement de configuration GENAI LAB
# Copiez ce fichier vers .env et adaptez les valeurs

APP_NAME="GENAI LAB - TP 2 ISIG-GOMA"
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1

# Configuration Ollama Local
OLLAMA_URL=http://localhost:11434
# Modèle Ollama (qwen2.5-coder:3b ou llama3.2 selon disponibilité)
MODELE=qwen2.5-coder:3b

# Configuration GPT-2 (HuggingFace)
GPT2_MODEL_NAME=openai-community/gpt2

# Configuration Embeddings (Sentence Transformers compact)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Configuration RAG
RAG_TOP_K=3
RAG_TEMPERATURE=0.0
